let items = [];
let isAdmin = false;

function loginAdmin() {
  const p = document.getElementById('adminPassInput').value;
  if (p === '20282028') {
    isAdmin = true;
    document.getElementById('adminLoginBox').style.display = 'none';
    document.getElementById('adminDashboardBox').style.display = 'block';
    document.querySelectorAll('.admin-only-tab').forEach(el => el.style.display = 'block');
    document.getElementById('nav-admin').innerText = '⚙️ Админка';
    alert('Успешный вход в панель администратора!');
    renderAll();
  } else {
    alert('Неверный пароль!');
  }
}

function logoutAdmin() {
  isAdmin = false;
  document.getElementById('adminPassInput').value = '';
  document.getElementById('adminLoginBox').style.display = 'block';
  document.getElementById('adminDashboardBox').style.display = 'none';
  document.querySelectorAll('.admin-only-tab').forEach(el => el.style.display = 'none');
  document.getElementById('nav-admin').innerText = '🔒 Админ';
  switchTab('add', document.querySelector('nav button'));
}

function loadStudents() {
  const k = document.getElementById('klassSelect').value;
  const s = document.getElementById('studentSelect');
  
  s.innerHTML = '<option value="">Выберите ученика</option>';
  
  if (k && studentsData[k]) {
    s.disabled = false;
    studentsData[k].forEach(name => {
      const opt = document.createElement('option');
      opt.value = name;
      opt.textContent = name;
      s.appendChild(opt);
    });
  } else {
    s.disabled = true;
    s.innerHTML = '<option value="">Сначала выберите класс</option>';
  }
}

function switchTab(tabId, btn) {
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('nav button').forEach(b => b.classList.remove('active'));
  document.getElementById('tab-' + tabId).classList.add('active');
  if(btn) btn.classList.add('active');
  renderAll();
}

document.getElementById('itemForm').addEventListener('submit', (e) => {
  e.preventDefault();
  const type = document.querySelector('input[name="type"]:checked').value;
  const klass = document.getElementById('klassSelect').value;
  const student = document.getElementById('studentSelect').value;
  const name = document.getElementById('itemName').value;
  const desc = document.getElementById('itemDesc').value;
  const photoInput = document.getElementById('itemPhoto');

  const saveAndReset = (photoData) => {
    items.push({ id: Date.now(), type, klass, student, name, desc, photo: photoData, archived: false });
    e.target.reset();
    document.getElementById('studentSelect').disabled = true;
    alert('Запись успешно добавлена!');
    renderAll();
  };

  if (photoInput.files && photoInput.files[0]) {
    const reader = new FileReader();
    reader.onload = (event) => saveAndReset(event.target.result);
    reader.readAsDataURL(photoInput.files[0]);
  } else {
    saveAndReset(null);
  }
});

function archiveItem(id) {
  const item = items.find(i => i.id === id);
  if (item) {
    item.archived = true;
    renderAll();
  }
}

function deletePermanently(id) {
  if (confirm('Вы уверены, что хотите навсегда удалить эту запись?')) {
    items = items.filter(i => i.id !== id);
    renderAll();
  }
}

function renderAll() {
  const lostL = document.getElementById('lostList');
  const foundL = document.getElementById('foundList');
  const archLostL = document.getElementById('archiveLostList');
  const archFoundL = document.getElementById('archiveFoundList');

  lostL.innerHTML = ''; foundL.innerHTML = '';
  archLostL.innerHTML = ''; archFoundL.innerHTML = '';

  const losts = items.filter(i => i.type === 'lost' && !i.archived);
  const founds = items.filter(i => i.type === 'found' && !i.archived);
  const archLosts = items.filter(i => i.type === 'lost' && i.archived);
  const archFounds = items.filter(i => i.type === 'found' && i.archived);

  lostL.innerHTML = losts.length === 0 ? '<p style="text-align:center; color:var(--text-muted); padding:40px; font-weight:500;">Нет потерянных вещей</p>' : losts.map(renderCard).join('');
  foundL.innerHTML = founds.length === 0 ? '<p style="text-align:center; color:var(--text-muted); padding:40px; font-weight:500;">Нет найденных вещей</p>' : founds.map(renderCard).join('');
  
  if (isAdmin) {
    archLostL.innerHTML = archLosts.length === 0 ? '<p style="text-align:center; color:var(--text-muted); padding:40px; font-weight:500;">Архив пуст</p>' : archLosts.map(renderCard).join('');
    archFoundL.innerHTML = archFounds.length === 0 ? '<p style="text-align:center; color:var(--text-muted); padding:40px; font-weight:500;">Архив пуст</p>' : archFounds.map(renderCard).join('');
  }

  renderStats();
}

function renderCard(item) {
  const photoHtml = item.photo 
    ? `<div class="item-photo"><img src="${item.photo}" alt="${item.name}"></div>`
    : `<div class="item-photo">Без фото</div>`;

  let actionBtns = '';
  if (isAdmin) {
    actionBtns = `
      <div class="action-buttons">
        ${!item.archived ? `<button class="btn-archive" onclick="archiveItem(${item.id})">В архив</button>` : ''}
        <button class="btn-danger" onclick="deletePermanently(${item.id})">Удалить</button>
      </div>
    `;
  }

  return `
    <div class="item-card">
      ${photoHtml}
      <div class="item-content">
        <div>
          <div class="item-title">${item.name}</div>
          <div class="item-desc">${item.desc}</div>
        </div>
        <div class="item-footer">
          <span class="badge-user">${item.student} (${item.klass})</span>
          ${actionBtns}
        </div>
      </div>
    </div>
  `;
}

function renderStats() {
  const classMap = {};
  const studentMap = {};

  items.forEach(item => {
    if (!classMap[item.klass]) classMap[item.klass] = { lost: 0, found: 0 };
    if (item.type === 'lost') classMap[item.klass].lost++;
    if (item.type === 'found') classMap[item.klass].found++;

    const userKey = `${item.student} (${item.klass})`;
    if (!studentMap[userKey]) studentMap[userKey] = { lost: 0, found: 0 };
    if (item.type === 'lost') studentMap[userKey].lost++;
    if (item.type === 'found') studentMap[userKey].found++;
  });

  const cRows = Object.entries(classMap).sort((a,b) => b[1].lost - a[1].lost);
  document.getElementById('classRatingBody').innerHTML = cRows.length ? cRows.map((c, i) => `
    <tr>
      <td>${i+1}</td>
      <td><b>${c[0]}</b></td>
      <td class="count-lost">${c[1].lost}</td>
      <td class="count-found">${c[1].found}</td>
    </tr>
  `).join('') : '<tr><td colspan="4" style="text-align:center; color:var(--text-muted);">Данных нет</td></tr>';

  const sRows = Object.entries(studentMap).sort((a,b) => b[1].lost - a[1].lost);
  document.getElementById('studentRatingBody').innerHTML = sRows.length ? sRows.map((s, i) => `
    <tr>
      <td>${i+1}</td>
      <td><b>${s[0]}</b></td>
      <td class="count-lost">${s[1].lost}</td>
      <td class="count-found">${s[1].found}</td>
    </tr>
  `).join('') : '<tr><td colspan="4" style="text-align:center; color:var(--text-muted);">Данных нет</td></tr>';
}
