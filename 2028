<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Lost & Found — Aktobe BIL</title>

<!-- Иконки сайта (Favicon) -->
<link rel="icon" type="image/jpeg" href="channels4_profile_5.jpg">
<link rel="shortcut icon" type="image/jpeg" href="channels4_profile_5.jpg">
<link rel="apple-touch-icon" href="channels4_profile_5.jpg">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    --bg-main: #07090e;
    --card-bg: rgba(15, 19, 29, 0.75);
    --card-border: rgba(212, 175, 55, 0.25);
    --card-border-hover: rgba(234, 202, 118, 0.6);
    --accent-gold: #f3d27d;
    --accent-gold-dark: #d4af37;
    --accent-glow: rgba(212, 175, 55, 0.25);
    --btn-primary: linear-gradient(135deg, #f3d27d 0%, #c49915 100%);
    --btn-primary-hover: linear-gradient(135deg, #fae19d 0%, #d4af37 100%);
    --text-primary: #f8fafc;
    --text-muted: #94a3b8;
    --danger: #f87171;
    --danger-light: rgba(239, 68, 68, 0.15);
    --success: #34d399;
    --radius-lg: 24px;
    --radius-md: 14px;
    --font-main: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: var(--font-main);
    background-color: var(--bg-main);
    color: var(--text-primary);
    min-height: 100vh;
    position: relative;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  /* Креативный фоновый водяной знак */
  .bg-watermark {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(90vw, 560px);
    height: min(90vw, 560px);
    background-image: url('channels4_profile_5.jpg');
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    opacity: 0.08;
    filter: drop-shadow(0 0 50px rgba(212, 175, 55, 0.4));
    z-index: -1;
    pointer-events: none;
  }

  .bg-glow-1 {
    position: fixed;
    top: -180px;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 400px;
    background: radial-gradient(circle, rgba(212, 175, 55, 0.18) 0%, rgba(10, 13, 20, 0) 70%);
    filter: blur(100px);
    z-index: -2;
    pointer-events: none;
  }

  header {
    background: rgba(7, 9, 14, 0.82);
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);
    border-bottom: 1px solid var(--card-border);
    padding: 26px 20px;
    text-align: center;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .logo-box {
    width: 90px;
    height: 90px;
    margin: 0 auto 12px;
    border-radius: 50%;
    border: 2px solid var(--accent-gold);
    box-shadow: 0 0 30px var(--accent-glow), inset 0 0 15px rgba(212, 175, 55, 0.3);
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 2px;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .logo-box:hover {
    transform: scale(1.08) rotate(3deg);
    box-shadow: 0 0 45px rgba(212, 175, 55, 0.6);
  }

  .logo-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  .brand-badge {
    display: inline-block;
    padding: 5px 16px;
    background: rgba(212, 175, 55, 0.08);
    border: 1px solid rgba(212, 175, 55, 0.3);
    border-radius: 30px;
    color: var(--accent-gold);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  header h1 {
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.5px;
    background: linear-gradient(135deg, #ffffff 30%, var(--accent-gold) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  header p {
    font-size: 13px;
    color: var(--text-muted);
    margin-top: 4px;
    font-weight: 500;
  }

  .container { max-width: 800px; margin: 0 auto; padding: 30px 16px 80px; }

  nav {
    display: flex;
    gap: 6px;
    background: rgba(15, 19, 29, 0.85);
    backdrop-filter: blur(25px);
    padding: 6px;
    border-radius: 20px;
    border: 1px solid var(--card-border);
    margin-bottom: 30px;
    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.5);
    overflow-x: auto;
  }

  nav button {
    flex: 1;
    padding: 12px 12px;
    border: none;
    background: transparent;
    color: var(--text-muted);
    font-weight: 700;
    font-size: 13px;
    border-radius: 14px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  nav button.active {
    background: var(--btn-primary);
    color: #07090e;
    font-weight: 800;
    box-shadow: 0 4px 20px rgba(212, 175, 55, 0.4);
  }

  .admin-only-tab { display: none; }
  .tab { display: none; }
  .tab.active { display: block; animation: fadeInScale 0.4s cubic-bezier(0.16, 1, 0.3, 1); }

  @keyframes fadeInScale {
    from { opacity: 0; transform: translateY(10px) scale(0.99); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .glass-card {
    background: var(--card-bg);
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    padding: 30px;
    box-shadow: 0 15px 45px rgba(0, 0, 0, 0.5);
    margin-bottom: 22px;
    transition: border-color 0.3s ease;
  }
  .glass-card:hover { border-color: rgba(212, 175, 55, 0.4); }

  .form-group { margin-bottom: 22px; }
  .form-group label { display: block; font-size: 13px; font-weight: 700; margin-bottom: 8px; color: var(--text-primary); }
  .form-group label .opt { font-weight: 500; font-size: 12px; color: var(--text-muted); }

  input[type="text"], input[type="password"], input[type="file"], select, textarea {
    width: 100%;
    padding: 14px 18px;
    background: rgba(7, 9, 14, 0.8);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-size: 14px;
    outline: none;
    transition: all 0.25s ease;
    font-family: inherit;
  }

  select option { background-color: #07090e; color: #ffffff; }
  input[type="file"] { padding: 11px 14px; cursor: pointer; }

  input[type="text"]:focus, input[type="password"]:focus, select:focus, textarea:focus {
    border-color: var(--accent-gold);
    box-shadow: 0 0 20px var(--accent-glow);
  }

  .radio-group { display: flex; gap: 12px; }
  .radio-group label {
    flex: 1;
    text-align: center;
    padding: 14px;
    background: rgba(7, 9, 14, 0.8);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    font-weight: 700;
    color: var(--text-muted);
    transition: all 0.25s ease;
  }

  .radio-group input { display: none; }
  .radio-group input:checked + span { color: var(--accent-gold); }
  .radio-group label:has(input:checked) {
    border-color: var(--accent-gold);
    background: rgba(212, 175, 55, 0.12);
    box-shadow: 0 0 20px var(--accent-glow);
  }

  .btn-submit {
    width: 100%;
    padding: 16px;
    background: var(--btn-primary);
    border: none;
    border-radius: var(--radius-md);
    color: #07090e;
    font-weight: 800;
    font-size: 15px;
    cursor: pointer;
    box-shadow: 0 6px 25px rgba(212, 175, 55, 0.35);
    transition: all 0.25s ease;
    margin-top: 10px;
  }
  .btn-submit:hover { background: var(--btn-primary-hover); transform: translateY(-2px); box-shadow: 0 8px 30px rgba(212, 175, 55, 0.5); }

  .action-buttons { display: flex; gap: 8px; }

  .btn-archive {
    background: rgba(212, 175, 55, 0.12);
    color: var(--accent-gold);
    border: 1px solid rgba(212, 175, 55, 0.35);
    padding: 7px 14px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .btn-archive:hover { background: var(--accent-gold); color: #07090e; }

  .btn-danger {
    background: var(--danger-light);
    color: var(--danger);
    border: 1px solid rgba(248, 113, 113, 0.3);
    padding: 7px 14px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .btn-danger:hover { background: var(--danger); color: #fff; }

  .item-card {
    background: var(--card-bg);
    backdrop-filter: blur(25px);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    padding: 22px;
    margin-bottom: 18px;
    display: flex;
    gap: 18px;
    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.4);
    transition: all 0.3s ease;
  }
  .item-card:hover { transform: translateY(-3px); border-color: var(--card-border-hover); box-shadow: 0 15px 40px var(--accent-glow); }

  .item-photo {
    width: 95px; height: 95px; min-width: 95px;
    border-radius: var(--radius-md);
    background: rgba(7, 9, 14, 0.9);
    border: 1px solid var(--card-border);
    overflow: hidden;
    display: flex; align-items: center; justify-content: center;
    font-size: 11px; color: var(--text-muted); font-weight: 600; text-align: center; padding: 4px;
  }
  .item-photo img { width: 100%; height: 100%; object-fit: cover; border-radius: 10px; }

  .item-content { flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
  .item-title { font-size: 17px; font-weight: 800; color: var(--text-primary); }
  .item-desc { font-size: 13.5px; color: var(--text-muted); margin-top: 6px; line-height: 1.5; white-space: pre-line; }
  .item-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 14px; flex-wrap: wrap; gap: 8px; }

  .badge-user {
    background: rgba(212, 175, 55, 0.1);
    color: var(--accent-gold);
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
    border: 1px solid rgba(212, 175, 55, 0.3);
  }

  table { width: 100%; border-collapse: collapse; margin-top: 10px; }
  th, td { padding: 14px 16px; text-align: left; font-size: 14px; border-bottom: 1px solid var(--card-border); }
  th { color: var(--accent-gold); text-transform: uppercase; font-size: 11px; letter-spacing: 1.2px; font-weight: 800; }

  .count-lost { color: var(--danger); font-weight: 800; }
  .count-found { color: var(--success); font-weight: 800; }
</style>
</head>
<body>

<div class="bg-watermark"></div>
<div class="bg-glow-1"></div>

<header>
  <div class="logo-box">
    <img src="channels4_profile_5.jpg" alt="БИЛ Логотип">
  </div>
  <div class="brand-badge">AKTOBE BIL</div>
  <h1>Lost & Found</h1>
  <p>Сервис поиска и учёта потерянных вещей</p>
</header>

<div class="container">

  <nav>
    <button class="active" onclick="switchTab('add', this)">+ Создать</button>
    <button onclick="switchTab('lost', this)">Потерянные</button>
    <button onclick="switchTab('found', this)">Найденные</button>

    <button class="admin-only-tab" id="nav-archive-lost" onclick="switchTab('archive-lost', this)">Архив Потерянных</button>
    <button class="admin-only-tab" id="nav-archive-found" onclick="switchTab('archive-found', this)">Архив Найденных</button>
    <button class="admin-only-tab" id="nav-rating" onclick="switchTab('rating', this)">Рейтинг</button>

    <button id="nav-admin" onclick="switchTab('admin', this)">🔒 Админ</button>
  </nav>

  <!-- Вкладка добавления -->
  <div class="tab active" id="tab-add">
    <div class="glass-card">
      <h2 style="margin-bottom:20px; font-size:20px; font-weight:800; color:var(--accent-gold);">Новая запись</h2>
      <form id="itemForm">
        <div class="form-group">
          <label>Тип события</label>
          <div class="radio-group">
            <label><input type="radio" name="type" value="lost" checked> <span>Потеряно</span></label>
            <label><input type="radio" name="type" value="found"> <span>Найдено</span></label>
          </div>
        </div>

        <div class="form-group">
          <label>Класс</label>
          <select id="klassSelect" required onchange="loadStudents()">
            <option value="">Выберите класс</option>
            <option value="7А">7А</option>
            <option value="7Ә">7Ә</option>
            <option value="8А">8А</option>
            <option value="8Ә">8Ә</option>
            <option value="9А">9А</option>
            <option value="9Ә">9Ә</option>
            <option value="10А">10А</option>
            <option value="10Ә">10Ә</option>
            <option value="11А">11А</option>
            <option value="11Ә">11Ә</option>
            <option value="TUTORS">Tutors (Абишки / Воспитатели)</option>
          </select>
        </div>

        <div class="form-group">
          <label>Ученик / Воспитатель</label>
          <select id="studentSelect" required disabled>
            <option value="">Сначала выберите класс</option>
          </select>
        </div>

        <div class="form-group">
          <label>Название предмета</label>
          <input type="text" id="itemName" placeholder="Ключи, худи, пенал..." required>
        </div>

        <div class="form-group">
          <label>Описание</label>
          <textarea id="itemDesc" rows="3" placeholder="Где оставили или нашли, внешние приметы..." required></textarea>
        </div>

        <div class="form-group">
          <label>Фотография предмета <span class="opt">(необязательно)</span></label>
          <input type="file" id="itemPhoto" accept="image/*">
        </div>

        <button type="submit" class="btn-submit">Опубликовать</button>
      </form>
    </div>
  </div>

  <!-- Активные Потерянные -->
  <div class="tab" id="tab-lost">
    <div id="lostList"></div>
  </div>

  <!-- Активные Найденные -->
  <div class="tab" id="tab-found">
    <div id="foundList"></div>
  </div>

  <!-- Архив Потерянных (Только Админ) -->
  <div class="tab" id="tab-archive-lost">
    <div class="glass-card" style="margin-bottom:18px;">
      <h2 style="font-size:18px; font-weight:800; color:var(--accent-gold);">📦 Архив потерянных вещей</h2>
    </div>
    <div id="archiveLostList"></div>
  </div>

  <!-- Архив Найденных (Только Админ) -->
  <div class="tab" id="tab-archive-found">
    <div class="glass-card" style="margin-bottom:18px;">
      <h2 style="font-size:18px; font-weight:800; color:var(--accent-gold);">📦 Архив найденных вещей</h2>
    </div>
    <div id="archiveFoundList"></div>
  </div>

  <!-- Рейтинг (Только Админ) -->
  <div class="tab" id="tab-rating">
    <div class="glass-card">
      <h2 style="font-size:18px; font-weight:800; margin-bottom:16px; color:var(--accent-gold);">📊 Статистика по классам</h2>
      <table>
        <thead>
          <tr><th>№</th><th>Класс</th><th>Потеряно</th><th>Найдено</th></tr>
        </thead>
        <tbody id="classRatingBody"></tbody>
      </table>
    </div>

    <div class="glass-card">
      <h2 style="font-size:18px; font-weight:800; margin-bottom:16px; color:var(--accent-gold);">👤 Статистика по ученикам</h2>
      <table>
        <thead>
          <tr><th>№</th><th>Имя</th><th>Потеряно</th><th>Найдено</th></tr>
        </thead>
        <tbody id="studentRatingBody"></tbody>
      </table>
    </div>
  </div>

  <!-- Авторизация Админа -->
  <div class="tab" id="tab-admin">
    <div class="glass-card" id="adminLoginBox">
      <h2 style="margin-bottom:16px; font-size:20px; font-weight:800; color:var(--accent-gold);">Вход в Админ-панель</h2>
      <div class="form-group">
        <label>Введите пароль администратора</label>
        <input type="password" id="adminPassInput" placeholder="Пароль">
      </div>
      <button class="btn-submit" onclick="loginAdmin()">Войти</button>
    </div>

    <div class="glass-card" id="adminDashboardBox" style="display:none; text-align:center;">
      <h2 style="font-size:20px; font-weight:800; color:var(--success); margin-bottom:10px;">✓ Режим Администратора активен</h2>
      <p style="color:var(--text-muted); font-size:14px; margin-bottom:20px;">Вам доступны: Архивирование, Безвозвратное удаление, Архив объявлений и Полная статистика.</p>
      <button class="btn-danger" style="padding:12px 24px; font-size:14px;" onclick="logoutAdmin()">Выйти из системы</button>
    </div>
  </div>

</div>

